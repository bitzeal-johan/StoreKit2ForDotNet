<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <Nullable>enable</Nullable>
    <IsBindingProject>true</IsBindingProject>
    <NoBindingEmbedding>false</NoBindingEmbedding>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>SK2ForDotNet</RootNamespace>
    <AssemblyName>SK2ForDotNet</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NuGet packaging -->
    <PackageId>SK2ForDotNet</PackageId>
    <Version>1.1.0</Version>
    <Authors>Johan Franzen</Authors>
    <Description>StoreKit 2 wrapper for .NET iOS projects. Bridges Apple's Swift-only StoreKit 2 APIs to .NET via @objc-compatible interfaces, enabling in-app purchases on iOS 15+ with .NET 10.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bitzeal-johan/StoreKit2ForDotNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ios;storekit;storekit2;in-app-purchase;iap;dotnet-ios;xamarin;maui;swift;xcframework</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="SK2ForDotNet.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>false</SmartLink>
      <ForceLoad>true</ForceLoad>
      <Frameworks>StoreKit Foundation</Frameworks>
    </NativeReference>
  </ItemGroup>
</Project>
